generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

model User {
  id Int @id @default(autoincrement())
  name String
  email String @unique
  passwordHash String
  role UserRole @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id Int @id @default(autoincrement())
  name String
  sku String @unique
  price Int
  stock Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
